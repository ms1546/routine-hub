{
  "name": "routine-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Routine Hub",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "postinstall": "node scripts/ensure-next-config.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.645.0",
    "@aws-sdk/client-secrets-manager": "^3.583.0",
    "@mastra/core": "^0.24.9",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "google-auth-library": "^9.14.1",
    "googleapis": "^130.0.0",
    "langfuse": "^3.38.6",
    "next": "^16.1.1",
    "next-auth": "^5.0.0-beta.30",
    "postcss": "^8.4.38",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^3.4.13",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.2.7",
    "@storybook/addon-interactions": "^8.2.7",
    "@storybook/nextjs": "^7.0.14",
    "@storybook/test": "^8.2.7",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.11.10",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitest/coverage-v8": "^2.1.4",
    "ajv": "^8.17.1",
    "ajv-keywords": "^5.1.0",
    "eslint": "^9.12.0",
    "eslint-config-next": "^16.1.1",
    "jsdom": "^27.4.0",
    "mastra": "^0.18.9",
    "shadcn": "^3.6.3",
    "storybook": "^8.2.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^4.0.16"
  }
